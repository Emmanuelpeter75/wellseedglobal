---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaStrip from '../components/CtaStrip.astro';
---
<Base title="Vision & Mission" description="The vision and mission of Wellseed Global: to equip people spiritually, financially and professionally, and to use resources to serve others.">
  <PageHero eyebrow="Vision &amp; Mission" title="Funding Kingdom Work. Transforming Lives.">
    <p>To see a generation of empowered people building resources that fund God's work, support churches and transform lives.</p>
  </PageHero>

  <section class="section vm-light" aria-label="Vision and mission">
    <div class="wrap">
      <div class="vm-grid">
        <article class="vm-card">
          <h3>Our Vision</h3>
          <p>To see Kingdom work adequately supported and lives transformed through Christ, reaching churches, communities and people in need.</p>
        </article>
        <article class="vm-card">
          <h3>Our Mission</h3>
          <p>To empower people spiritually and financially, equipping them to build businesses, create wealth and develop resources that can fund God's work and transform lives.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="how-head">
        <span class="eyebrow">Our approach</span>
        <h2 id="approach-title">From people, to resources, to impact.</h2>
      </div>
      <ol class="flow">
        <li><span class="k">One</span><h3>Empower people</h3><p>Developing people spiritually, equipping them with financial knowledge, business skills and the abilities needed to build resources.</p></li>
        <li><span class="k">Two</span><h3>Build wealth and resources</h3><p>Encouraging entrepreneurship, business development and responsible wealth creation to build resources that can sustain and fund Kingdom work.</p></li>
        <li><span class="k">Three</span><h3>Fund Kingdom work and impact lives</h3><p>Using the resources generated to support churches, fund God's work, help the less privileged and bring meaningful change to communities.</p></li>
      </ol>
    </div>
  </section>

  

  <CtaStrip title="Help us carry this vision forward." />
</Base>
