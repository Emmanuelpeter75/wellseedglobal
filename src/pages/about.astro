---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaStrip from '../components/CtaStrip.astro';
---
<Base title="About" description="Learn who Wellseed Global is: a Christ-centred impact movement developing people, building sustainable resources and serving others.">
  <PageHero eyebrow="About" title="Who We Are">
    <p>Wellseed Global is a Christ-centred movement committed to funding God's Kingdom work and transforming lives through Christ.</p>
  </PageHero>

  <section class="section" aria-labelledby="story-title">
    <div class="wrap split">
      <div class="sticky">
        <span class="eyebrow">Our purpose</span>
        <h2 id="story-title">Funding Kingdom work. Transforming lives.</h2>
      </div>
      <div class="prose">
        <p class="lead">Wellseed Global is a Christ-centred movement with a vision to fund Kingdom work and transform lives through Christ.</p>
        <p>We believe that one way to achieve this is by empowering people to build the resources needed to support God's work and make a lasting difference in the lives of others.</p>
        <p>We bring young Christians together to grow in Christ, develop their abilities, learn about finances and entrepreneurship, and build businesses and resources. Our desire is to raise people who are not only equipped to build wealth but are also willing to use what they build to support churches, help the less privileged and reach communities with the love of Christ.</p>
        <p>Wellseed Global is at an early stage. We are beginning with the empowerment and development of people, and we are building the movement step by step.</p>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="believe-title">
    <div class="wrap split">
      <div class="sticky">
        <span class="eyebrow">How We Fulfil Our Mission</span>
        <h2 id="believe-title">The principles behind our work.</h2>
      </div>
      <ul class="values">
        <li><strong>Christ at the Centre</strong>We put Christ at the centre of all we do, giving Him the glory in every impact.</li>
        <li><strong>Spiritual Growth</strong>We grow in our relationship with God, building our faith, character and understanding of His Word.</li>
        <li><strong>Financial empowerment</strong>We develop financial knowledge and business skills to build wealth and manage resources wisely.</li>
        <li><strong>Generosity and Kingdom Impact</strong>We use the resources we build to support God's work and transform lives</li>
      </ul>
    </div>
  </section>

  <section class="section closing on-navy" aria-labelledby="foundation-title">
    <div class="wrap">
      <span class="eyebrow">Our foundation</span>
      <h2 id="foundation-title">Christ is at the centre of all we do.</h2>
      <p class="lead">Our mission is to fund Kingdom work and transform lives. <br> Everything we build, every resource we create and every life we touch should advance God's Kingdom and  bring glory to His name.</p>
    </div>
  </section>

  <CtaStrip title="There is a place for you in this mission." />
</Base>
